" -----------------------------
" Basic Vim configuration
" -----------------------------

" Enable line numbers
set number

" Enable syntax highlighting
syntax on

" Enable auto-indentation
set autoindent
set smartindent

" Set tab width to 4 spaces
set tabstop=4
set shiftwidth=4
set expandtab

" Show matching parentheses
set showmatch

" Highlight the current line
set cursorline

" Enable incremental search
set incsearch
set ignorecase
set smartcase

" Set a simple colorscheme
colorscheme default

" Enable mouse in all modes
set mouse=a
